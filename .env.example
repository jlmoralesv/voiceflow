# Clave del endpoint de transcripción (OpenAI u otro compatible).
# Opcional aquí: también se puede pegar en el panel de Ajustes de la app.
# También se acepta OPENAI_API_KEY.
VOICEFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint de transcripción. Opcional (por defecto el de OpenAI).
# Para un servidor local: http://localhost:8000/v1/audio/transcriptions
VOICEFLOW_API_URL=https://api.openai.com/v1/audio/transcriptions

# Modelo de transcripción. gpt-4o-mini-transcribe mide ~4x más rápido que whisper-1
# en pruebas reales (~1.1s vs ~4.1s en un clip de 9s), por eso es el default.
VOICEFLOW_MODEL=gpt-4o-mini-transcribe
VOICEFLOW_TEXT_MODEL=gpt-4o-mini
