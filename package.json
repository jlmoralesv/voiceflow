{
  "name": "voiceflow",
  "version": "0.1.1",
  "description": "Educational reimplementation of Typeless: global-hotkey voice dictation that transcribes and types into the focused app.",
  "main": "src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "electron",
    "speech-to-text",
    "dictation",
    "voice-typing",
    "whisper",
    "transcription"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.voiceflow.app",
    "productName": "VoiceFlow",
    "asar": false,
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
